{
  "name": "wa-askable",
  "version": "0.3.0",
  "private": true,
  "description": "A local archive of your WhatsApp, and a way to ask it questions.",
  "author": {
    "name": "hadywalied",
    "email": "my.mepharo1230@gmail.com"
  },
  "homepage": "https://github.com/hadywalied/wa-askable",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "rebuild": "electron-rebuild -f -m . -w better-sqlite3",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test/",
    "setup": "node scripts/postinstall.mjs --strict",
    "smoke": "electron-vite build && WA_SMOKE=1 electron out/main/index.js",
    "smoke:lifecycle": "electron-vite build && WA_SMOKE=lifecycle electron out/main/index.js",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "smoke:connect": "electron-vite build && WA_SMOKE=connect electron out/main/index.js"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "electron",
    "electron-winstaller",
    "esbuild"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "better-sqlite3": "^13.0.3",
    "openai": "^7.15.0",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
